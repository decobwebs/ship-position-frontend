# ============================================================
# Lagos Port Vessel Intelligence — frontend ENV TEMPLATE
# Copy to `.env` for local dev. On Vercel, set this in Project Settings
# → Environment Variables (Production + Preview).
# ============================================================

# Base URL of the deployed backend API (Render), no trailing slash.
# Defaults to http://127.0.0.1:8078 for local dev if unset.
NUXT_PUBLIC_API_BASE=https://your-backend.onrender.com
